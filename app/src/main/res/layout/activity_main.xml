<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vault_bg"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <ScrollView
        android:id="@+id/lockView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock"
                app:tint="@color/vault_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/unlock_title"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/unlockSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/pin_enter_subtitle"
                android:textColor="#9AA4B2" />

            <TextView
                android:id="@+id/pinDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.3"
                android:text="@string/pin_dots_empty"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPinError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="#FF6B6B"
                android:textSize="14sp" />

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="3"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pad1"
                    style="@style/PadButton"
                    android:text="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pad2"
                    style="@style/PadButton"
                    android:text="2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pad3"
                    style="@style/PadButton"
                    android:text="3" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pad4"
                    style="@style/PadButton"
                    android:text="4" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pad5"
                    style="@style/PadButton"
                    android:text="5" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pad6"
                    style="@style/PadButton"
                    android:text="6" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pad7"
                    style="@style/PadButton"
                    android:text="7" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pad8"
                    style="@style/PadButton"
                    android:text="8" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pad9"
                    style="@style/PadButton"
                    android:text="9" />

                <Space
                    android:layout_width="72dp"
                    android:layout_height="60dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pad0"
                    style="@style/PadButton"
                    android:text="0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/padDel"
                    style="@style/PadButton.Icon"
                    android:contentDescription="@string/pad_delete"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart" />
            </GridLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/mainView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerEntries"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingBottom="100dp" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/empty_vault"
            android:textColor="#9AA4B2"
            android:visibility="gone" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="32dp"
            android:contentDescription="@string/btn_add"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/vault_accent"
            app:tint="@android:color/white" />
    </LinearLayout>
</FrameLayout>
